# GPTZero — text detection, primary provider
# https://gptzero.stoplight.io/
GPTZERO_API_KEY=

# Sapling — text detection, fallback #2
# https://sapling.ai/docs/api/detector
SAPLING_API_KEY=

# ZeroGPT — text detection, last resort
# No documented authenticated API confirmed as of writing; left blank/unused.
# Verify current terms before wiring this in (see lib/providers/text/zerogpt.ts).
ZEROGPT_API_KEY=

# Sightengine — image (and video frame) detection, primary provider
# https://sightengine.com/docs/ai-generated-image-detection
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=

# AI or Not — image detection, fallback #2
# No confirmed authenticated API as of writing; left blank/unused.
# Verify current terms before wiring this in (see lib/providers/image/aiornot.ts).
AIORNOT_API_KEY=
