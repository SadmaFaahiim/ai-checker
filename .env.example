# GPTZero — text detection, primary provider
# https://gptzero.stoplight.io/
GPTZERO_API_KEY=

# Sapling — text detection, fallback #2
# https://sapling.ai/docs/api/detector
SAPLING_API_KEY=

# ZeroGPT — text detection, last resort
# No documented authenticated API confirmed as of writing; left blank/unused.
# Verify current terms before wiring this in (see lib/providers/text/zerogpt.ts).
ZEROGPT_API_KEY=

# Sightengine — image, audio, and video-frame detection, primary provider
# https://sightengine.com/docs/ai-generated-image-detection
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=

# AI or Not — image detection, fallback #2
# No confirmed authenticated API as of writing; left blank/unused.
# Verify current terms before wiring this in (see lib/providers/image/aiornot.ts).
AIORNOT_API_KEY=

# Rate limiting — secret for hashing client IPs (issue #4 / F2, GDPR)
# Client IPs are HMAC-hashed with this secret before they touch rate-limit
# keys or logs; raw IPs are never persisted. Set the SAME secret on every
# instance so limits stay consistent across a multi-instance deployment.
RATE_LIMIT_IP_SECRET=

# Sentry — server-side error tracking (TASKS.md O2)
# Sign up at https://sentry.io → create a Next.js project → copy the DSN.
# Leave blank to disable entirely: every Sentry helper is a no-op without a
# DSN, so local dev and CI stay silent. The DSN is safe to expose to the
# browser (it only permits sending events, never reading them).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
